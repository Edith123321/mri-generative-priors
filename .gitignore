# Patient data — never commit (fastMRI Data Sharing Agreement)
data/raw/
data/processed/
*.h5
# Any derived array dump, wherever it lands: the prep notebooks write their own
# cache outside data/, and a 128x128 magnitude slice is still patient-derived.
*.npz
notebooks/prep/data/
# Metadata reports: these carry patient_id hashes and local absolute paths.
notebooks/prep/metadata.json
notebooks/prep/metadata_table.txt

# Generated figures / run artifacts (no images in commits — CLAUDE.md data rules)
outputs/
*.png

# Checkpoints distributed out of band (large; not data)
checkpoints/*.eqx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# pixi (lockfile is committed for reproducible envs / CI)
.pixi/

# editors / OS
.vscode/
.idea/
.DS_Store
